{
  "schema_version": 1,
  "fixture_id": "hydrated_multisystem_rcsb_external",
  "distribution": "metadata_only",
  "contains_upstream_structure_files": false,
  "contains_parameter_files": false,
  "contains_maps_or_outputs": false,
  "contains_executables": false,
  "purpose": "通过 DockStart 当前公开项目 API 对 2BYS 与 2ZJU 执行受体/配体准备、水合配体、AutoGrid、Vina、后处理和报告链；下载物与运行产物仅存在于临时目录",
  "source_policy": {
    "provider": "RCSB PDB",
    "download_at_verification_time": true,
    "receptor_pdb_identity": "exact_wire_size_sha256_v1",
    "model_server_ligand_sdf_identity": "canonical_scientific_content_v1",
    "model_server_ligand_sdf_canonicalization": "model_server_sdf_mol_block_lf_v1",
    "wire_size_sha256_and_final_url_recorded_for_audit": true,
    "redirects_must_remain_https": true,
    "maximum_source_size_bytes": 5000000,
    "license_reference": "https://www.rcsb.org/pages/policies",
    "no_upstream_bytes_committed": true
  },
  "toolchain": {
    "python": {
      "version": "3.11.15",
      "caller_path_and_sha256_required": true
    },
    "rdkit": {
      "version": "2026.03.3",
      "caller_python_module_path_and_sha256_required": true
    },
    "meeko": {
      "version": "0.7.1",
      "caller_python_module_path_and_sha256_required": true
    },
    "autogrid": {
      "version": "4.2.7",
      "caller_path_and_sha256_required": true,
      "must_be_external": true
    },
    "vina": {
      "version": "1.2.7",
      "caller_path_and_sha256_required": true,
      "maps_capability_required": true
    }
  },
  "protocol": {
    "protocol_id": "hydrated_ad4_experimental",
    "project_api_chain": [
      "create_project",
      "import_receptor_raw_file",
      "import_ligand_raw_file",
      "prepare_receptor_pdbqt",
      "prepare_ligand_pdbqt",
      "update_box_params",
      "update_vina_params",
      "prepare_hydrated_ligand",
      "generate_hydrated_maps",
      "get_hydrated_run_preflight",
      "prepare_hydrated_run",
      "execute_prepared_vina_run",
      "analyze_vina_run_results",
      "load_hydrated_results",
      "export_markdown_report"
    ],
    "grid": {
      "spacing": 0.375,
      "grid_points": {
        "x": 54,
        "y": 54,
        "z": 54
      },
      "actual_size_angstrom": {
        "x": 20.25,
        "y": 20.25,
        "z": 20.25
      },
      "requested_size_angstrom": {
        "x": 20.0,
        "y": 20.0,
        "z": 20.0
      },
      "minimum_margin_angstrom": 0.125,
      "coverage_required": true
    },
    "vina": {
      "scoring": "ad4",
      "exhaustiveness": 8,
      "num_modes": 9,
      "energy_range": 4,
      "cpu": 4,
      "seed": 20260730,
      "verbosity": 1,
      "allowed_continuous_mode_ids": [
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9
      ]
    },
    "postprocess": {
      "raw_water_count_equals_prepared_water_count_times_modes": true,
      "retained_equals_strong_plus_weak": true,
      "raw_equals_retained_plus_displaced": true,
      "raw_affinity_must_remain_unchanged": true
    },
    "report": {
      "required_phrases": [
        "# DockStart 实验性水合 AD4 对接报告",
        "## 冻结 Box 与实际网格覆盖",
        "水分子过滤只用于结构解释，不会产生或替换 affinity。",
        "处理后评分未计算",
        "不用于虚拟筛选",
        "不支持跨配体、跨评分函数或跨协议直接比较分值",
        "Docking score 仅供结构结合趋势参考，不能替代实验验证。"
      ],
      "run_and_project_report_bytes_must_match": true,
      "run_and_project_scores_bytes_must_match": true
    },
    "diagnostic_policy": {
      "best_affinity_is_non_gating": true,
      "reference_hashes_are_non_gating_across_platforms": true,
      "pose_rmsd_is_known_negative_diagnostic_only": true
    }
  },
